# Installable bot: run npm run setup to save the secret locally.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=1549241607386046516
JOURNAL_TIME_ZONE=America/Toronto
BOT_STATE_DIR=data/installable
# Alternate bot: save these two values privately in .env.threads to run both bots.
# THREAD_DISCORD_BOT_TOKEN=
# THREAD_DISCORD_APPLICATION_ID=
# THREAD_BOT_STATE_DIR=data/threaded
# Research Journal Hub uses the main bot identity unless these overrides are set in .env.hub:
# HUB_DISCORD_BOT_TOKEN=
# HUB_DISCORD_APPLICATION_ID=
# HUB_BOT_STATE_DIR=data/hub
# Optional official IEEE metadata API key for automatic unfamiliar-link lookup and abstracts:
# IEEE_XPLORE_API_KEY=
# Optional legacy webhook mode only:
DISCORD_WEBHOOK_URL=
# Optional existing thread within that channel:
DISCORD_THREAD_ID=
# Optional contact address for Crossref's polite pool:
CROSSREF_MAILTO=
CHECK_INTERVAL_HOURS=24
# Discord attachment cap can vary; the bot uses a conservative 9 MiB default.
MAX_PDF_BYTES=9437184
# true waits for your authorized PDF before announcing an issue.
# false posts links first, then edits the original message when the PDF arrives.
REQUIRE_PDF=false
# Automatically retrieve the current Wiley Issue Highlights PDF using Crossref's link.
AUTO_WILEY_HIGHLIGHTS=true
# Set true only if your permission/license covers redistribution to this Discord server.
WILEY_PDF_REDISTRIBUTION_ALLOWED=false
ISSUE_MANIFEST=issues.json
STATE_DIR=data
